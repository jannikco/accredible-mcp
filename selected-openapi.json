{
  "openapi": "3.1.0",
  "info": {
    "title": "Accredible Certificates selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://api.accredible.com"
    }
  ],
  "paths": {
    "/v1/credentials/{id}": {
      "get": {
        "operationId": "accredible_get_credential",
        "summary": "accredible get credential",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    },
    "/v1/credentials": {
      "post": {
        "operationId": "accredible_create_credential",
        "summary": "Create an unapproved credential in an existing group. Supply name/description when not configured on the group.",
        "parameters": [],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "credential": {
                    "const": {
                      "approve": false
                    },
                    "default": {
                      "approve": false
                    }
                  }
                },
                "required": [
                  "credential"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
